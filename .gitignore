/[Rr]ecordings/
.utmp/
.cxx/

# Logs y Crash Reports
*.log
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# --- Builds y Paquetes de Salida ---
*.apk
*.aab
*.obb
*.app
*.unitypackage
*.unitypackage.meta
ExportedObj/
/ServerData/

# --- Gradle & Android (Meta Quest / Android XR) ---
.gradle/
local.properties
captures/
.externalNativeBuild/

# --- IDEs y Editores de Código ---
